<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes only, only from Amazon's launcher and Appstore. Never reads screen content and never
     filters keys, so held keys such as Volume keep repeating. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.amazon.tv.launcher,com.amazon.venezia"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/fire_home_description" />
